local mt = getrawmetatable(game)
if mt and setreadonly and newcclosure then
	setreadonly(mt, false)
	local old_index = mt.__index
	mt.__index = newcclosure(function(t, k)
		if t:IsA("Humanoid") then
			if k == "WalkSpeed" and _G.IsToggled then
				return _G.defaultWalkSpeed
			elseif (k == "JumpPower" or k == "JumpHeight") and _G.JumpToggled then
				return k == "JumpPower" and _G.defaultJumpPower or _G.defaultJumpHeight
			end
		end
		return old_index(t, k)
	end)
	setreadonly(mt, true)
end

