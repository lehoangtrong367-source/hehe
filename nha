local dragToggleBtn, dragToggleMenu = false, false
local dragStartBtn, startPosBtn
local dragStartMenu, startPosMenu
local hasMovedBtn = false

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		if dragToggleBtn then
			local delta = input.Position - dragStartBtn
			if delta.Magnitude > 5 then hasMovedBtn = true end
			MainButton.Position = UDim2.new(startPosBtn.X.Scale, startPosBtn.X.Offset + delta.X, startPosBtn.Y.Scale, startPosBtn.Y.Offset + delta.Y)
		end
		if dragToggleMenu then
			local delta = input.Position - dragStartMenu
			MenuPanel.Position = UDim2.new(startPosMenu.X.Scale, startPosMenu.X.Offset + delta.X, startPosMenu.Y.Scale, startPosMenu.Y.Offset + delta.Y)
		end
	end
end)

MainButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragToggleBtn = true
		dragStartBtn = input.Position
		startPosBtn = MainButton.Position
		hasMovedBtn = false
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragToggleBtn = false end
		end)
	end
end)

MainButton.MouseButton1Up:Connect(function()
	if not hasMovedBtn then 
		MenuPanel.Visible = not MenuPanel.Visible 
		if MenuPanel.Visible then
			MenuPanel.Position = UDim2.new(MainButton.Position.X.Scale, MainButton.Position.X.Offset + MainButton.Size.X.Offset + 10, MainButton.Position.Y.Scale, MainButton.Position.Y.Offset)
		end
	end
end)

MenuPanel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local target = game:GetService("GuiService"):GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)
		local isTextBox = false
		for _, obj in pairs(target) do
			if obj:IsA("TextBox") then isTextBox = true break end
		end
		if not isTextBox then
			dragToggleMenu = true
			dragStartMenu = input.Position
			startPosMenu = MenuPanel.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragToggleMenu = false end
			end)
		end
	end
end)
local function removeFlyForce()
	if _G.flyVelocity then _G.flyVelocity:Destroy(); _G.flyVelocity = nil end
	if _G.flyAttachment then _G.flyAttachment:Destroy(); _G.flyAttachment = nil end
	if _G.flyGyro then _G.flyGyro:Destroy(); _G.flyGyro = nil end
end

local function getCustomMoveDirection()
	local camera = workspace.CurrentCamera
	if not camera then return Vector3.new(0, 0, 0) end
	local PlayerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
	local PlayerModule = PlayerScripts and PlayerScripts:FindFirstChild("PlayerModule")
	local controlModule = PlayerModule and require(PlayerModule):GetControls()
	local moveDirection = Vector3.new(0, 0, 0)
	
	if controlModule then
		moveDirection = controlModule:GetMoveVector()
	else
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Vector3.new(0, 0, -1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection + Vector3.new(0, 0, 1) end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection + Vector3.new(-1, 0, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Vector3.new(1, 0, 0) end
	end
	
	local cameraCFrame = camera.CFrame
	local finalDirection = (cameraCFrame.RightVector * moveDirection.X) + (cameraCFrame.LookVector * -moveDirection.Z)
	return finalDirection.Magnitude > 0 and finalDirection.Unit or Vector3.new(0, 0, 0)
end

