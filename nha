FlyBtn.MouseButton1Click:Connect(function()
	_G.FlyToggled = not _G.FlyToggled
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	
	if _G.FlyToggled then
		FlyBtn.Text = "BAY: ON"
		FlyBtn.BackgroundColor3 = Color3.fromRGB(251, 191, 36)
		FlyBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
		if rootPart and not _G.flyVelocity then
			_G.flyAttachment = Instance.new("Attachment")
			_G.flyAttachment.Name = "FlyAttachment"
			_G.flyAttachment.Parent = rootPart
			_G.flyVelocity = Instance.new("LinearVelocity")
			_G.flyVelocity.Name = "FlyVelocity"
			_G.flyVelocity.Attachment0 = _G.flyAttachment
			_G.flyVelocity.MaxForce = math.huge
			_G.flyVelocity.VectorVelocity = Vector3.new(0, 0, 0)
			_G.flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
			_G.flyVelocity.Parent = rootPart
			_G.flyGyro = Instance.new("BodyGyro")
			_G.flyGyro.Name = "FlyGyro"
			_G.flyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
			_G.flyGyro.P = 9000
			_G.flyGyro.cframe = rootPart.CFrame
			_G.flyGyro.Parent = rootPart
		end
	else
		FlyBtn.Text = "BAY: OFF"
		FlyBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
		FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		removeFlyForce()
		if humanoid then humanoid.PlatformStand = false end
	end
end)

