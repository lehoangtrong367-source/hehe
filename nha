RunService.PreSimulation:Connect(function(deltaTime)
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end

	if _G.NoclipToggled then
		for _, part in pairs(character:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = false end
		end
	end

	if not _G.FlyToggled then
		humanoid.WalkSpeed = _G.IsToggled and _G.CurrentSpeed or _G.defaultWalkSpeed
	end

	if not _G.FlyToggled then
		if _G.JumpToggled then
			if humanoid.UseJumpPower then humanoid.JumpPower = _G.CurrentJump else humanoid.JumpHeight = _G.CurrentJump end
		else
			if humanoid.UseJumpPower then humanoid.JumpPower = _G.defaultJumpPower else humanoid.JumpHeight = _G.defaultJumpHeight end
		end
	end

	if _G.FlyToggled and _G.flyVelocity and _G.flyGyro then
		if not humanoid.PlatformStand then humanoid.PlatformStand = true end
		local camera = workspace.CurrentCamera
		if camera then _G.flyGyro.cframe = camera.CFrame end
		local flyDir = getCustomMoveDirection()
		_G.flyVelocity.VectorVelocity = flyDir * _G.CurrentFlySpeed
	end
end)
