InvisibleBtn.MouseButton1Click:Connect(function()
	_G.InvisibilityToggled = not _G.InvisibilityToggled
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if _G.InvisibilityToggled then
		InvisibleBtn.Text = "T.HÌNH: ON"
		InvisibleBtn.BackgroundColor3 = Color3.fromRGB(251, 191, 36)
		InvisibleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
		if character and humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") or part:IsA("Decal") then
					if not part:GetAttribute("OriginalTransparency") then part:SetAttribute("OriginalTransparency", part.Transparency) end
					part.Transparency = (part.Name == "HumanoidRootPart") and 1 or 0.5
				end
			end
		end
	else
		InvisibleBtn.Text = "T.HÌNH: OFF"
		InvisibleBtn.BackgroundColor3 = Color3.fromRGB(220, 38, 38)
		InvisibleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		if character and humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			for _, part in pairs(character:GetDescendants()) do
				if part:IsA("BasePart") or part:IsA("Decal") then
					local orig = part:GetAttribute("OriginalTransparency")
					if orig then 
						part.Transparency = orig
						part:SetAttribute("OriginalTransparency", nil) 
					end
				end
			end
		end
	end
end)

